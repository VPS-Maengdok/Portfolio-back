# Copy to .env and replace every fake value. Never commit the real file.

###> symfony/framework-bundle ###
# Symfony environment: dev, test or prod
APP_ENV=prod
# Enables debug mode and profiler (0 or 1, read by the Symfony runtime; always 0 in prod)
APP_DEBUG=0
# Secret used for signing and CSRF; generate a long random string
APP_SECRET=changeme
###< symfony/framework-bundle ###

###> symfony/routing ###
# Base URL used to generate absolute URLs in CLI contexts
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> TRUSTED HOSTS ###
# Currently UNUSED: nothing reads it (Symfony reads SYMFONY_TRUSTED_PROXIES); trusted proxies are wired in P0.4
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
# Currently UNUSED: nothing reads it (Symfony reads SYMFONY_TRUSTED_HOSTS); to be wired in P0.4
TRUSTED_HOSTS='^(localhost|api\.example\.com)$'
###< TRUSTED HOSTS ###

###> doctrine/doctrine-bundle ###
# PostgreSQL connection URL (user, password and database come from the shared postgresql stack)
DATABASE_URL="postgresql://app:changeme@postgres:5432/app?serverVersion=17&charset=utf8"
# Optional suffix for the test database, normally set by ParaTest (leave unset otherwise)
# TEST_TOKEN=
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
# Regex of origins allowed to call the API (CORS)
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1|example\.com)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> knplabs/knp-snappy-bundle ###
# Path of the wkhtmltopdf binary used for the CV PDF
WKHTMLTOPDF_PATH=/usr/bin/wkhtmltopdf
# Path of the wkhtmltoimage binary
WKHTMLTOIMAGE_PATH=/usr/bin/wkhtmltoimage
###< knplabs/knp-snappy-bundle ###
